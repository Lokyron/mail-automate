# HTTPS sur le reseau local, certificat auto-signe (`tls internal`). Le
# navigateur avertira une premiere fois : c'est attendu, il n'y a pas
# d'autorite publique pour une adresse privee.
#
# Pour un vrai certificat, remplacer le bloc d'adresse par un nom de domaine
# pointant sur la machine et retirer la ligne `tls internal` — Caddy obtient et
# renouvelle alors le certificat tout seul.
:443 {
	tls internal

	encode zstd gzip

	# L'application fixe elle-meme ses en-tetes de securite (helmet) : on ne
	# les redouble pas ici, pour n'avoir qu'un seul endroit a corriger.
	reverse_proxy app:8090 {
		header_up X-Forwarded-Proto {scheme}
	}
}
