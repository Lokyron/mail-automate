# ---------------------------------------------------------------------------
# Inbox Agent — configuration
# Copier en .env et renseigner. Aucune valeur sensible n'a de defaut utile.
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# Le serveur n'ecoute que sur la boucle locale : l'acces passe par un reverse
# proxy qui porte le TLS. Une application qui detient le mot de passe d'une
# boite mail personnelle n'a rien a faire sur 0.0.0.0.
#
# SOUS DOCKER, ces deux valeurs sont IGNOREES : docker-compose.yml impose
# HOST=0.0.0.0 (sinon la redirection de port ne mene nulle part) et publie le
# port sur la seule boucle locale de l'hote. Pour changer le port cote hote,
# utiliser PORT_HOTE plus bas.
HOST=127.0.0.1
PORT=8090
PUBLIC_URL=https://inbox.exemple.fr
# TRUSTED_PROXIES=127.0.0.1

# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=168

ADMIN_USER=admin
# npm run hash
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# PHASE. Le reglage le plus important du fichier.
#
# false (phase 0) : lecture seule absolue. Aucun libelle pose, aucun brouillon
#   depose, aucun message marque lu, aucun envoi. Les propositions restent dans
#   l'interface. C'est l'etat dans lequel l'application doit tourner tant que le
#   tri n'a pas fait ses preuves sur une semaine de courrier reel.
# true (phase 1) : l'ecriture devient possible. A ne basculer que lorsque le
#   taux de tri juste affiche en haut de l'interface est satisfaisant.
# ---------------------------------------------------------------------------
WRITE_ENABLED=false

# --- Boite mail (IMAP, lecture seule) --------------------------------------
# Gmail : mot de passe d'application (compte Google > Securite > Validation en
# deux etapes > Mots de passe des applications). Pas le mot de passe du compte.
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=120
# Jours de courrier deja present a reprendre au premier demarrage. Sans ce
# rattrapage, il faudrait attendre une semaine avant d'avoir de quoi juger.
IMAP_BACKFILL_DAYS=7

# --- Modele de langage ------------------------------------------------------
LLM_PROVIDER=claude
LLM_DAILY_CALL_LIMIT=400
LLM_CONFIDENCE_THRESHOLD=0.7
LLM_MAX_BODY_CHARS=6000

CLAUDE_API_KEY=
CLAUDE_CLASSIFY_MODEL=claude-haiku-5-5
CLAUDE_DRAFT_MODEL=claude-sonnet-5-5

# Fournisseur de rechange. GEMINI_API_REVISION est epingle volontairement.
GEMINI_API_KEY=
GEMINI_CLASSIFY_MODEL=gemini-3.5-flash-lite
GEMINI_DRAFT_MODEL=gemini-3.5-flash
GEMINI_API_REVISION=2026-05-20

# --- Tri et redaction -------------------------------------------------------
TRIAGE_AUTO=true
TRIAGE_EXAMPLES=12

DRAFTS_AUTO=true
# Formule de fin apposee par le modele. Vide = pas de signature.
DRAFTS_SIGNATURE=
DRAFTS_MAX_OUTPUT_TOKENS=3000
DRAFTS_TEMPERATURE=0.3

# --- Envoi (SMTP) -----------------------------------------------------------
# Memes identifiants que la lecture par defaut : le mot de passe d'application
# Google ouvre les deux. Gmail enregistre lui-meme dans « Envoyes ».
# Un envoi exige TOUJOURS : WRITE_ENABLED=true, un recapitulatif affiche, et une
# confirmation. Aucun texte, aucun courriel, aucun modele ne peut l'obtenir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# SMTP_USER=            # a defaut : IMAP_USER
# SMTP_PASS=            # a defaut : IMAP_PASS
MAIL_FROM_NAME=
# MAIL_FROM_EMAIL=      # a defaut : SMTP_USER
SMTP_DAILY_LIMIT=50

# --- Salon de discussion (Telegram) -----------------------------------------
# Creer le bot aupres de @BotFather, puis relever son identifiant de salon en
# ecrivant au bot et en consultant /api/system/status (ou @userinfobot).
#
# TELEGRAM_CHAT_ID est une LISTE BLANCHE : le bot est muet pour tout le monde
# sauf les salons listes. Sans elle, le demarrage est refuse — le nom d'un bot
# Telegram est public, son usage ne doit pas l'etre.
BOT_ENABLED=false
BOT_PLATFORM=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false : les cartes portent expediteur, objet et resume, jamais le corps du
# courrier. Telegram ne chiffre pas de bout en bout les discussions ordinaires :
# le salon transporte des decisions, pas de la correspondance. Le corps reste
# accessible a la demande, par le bouton « Voir ».
BOT_BODY_IN_CHAT=false
BOT_POLL_SECONDS=30

# --- Conversation avec l'agent ----------------------------------------------
# L'agent peut chercher, lire, reecrire un brouillon et PREPARER un envoi.
# Il n'a aucun outil d'envoi : c'est structurel, pas un reglage.
CHAT_ENABLED=true
CHAT_HISTORY_TURNS=12
CHAT_MAX_TOOL_CALLS=8
CHAT_MAX_OUTPUT_TOKENS=2000

# ---------------------------------------------------------------------------
# COURRIER HORS DE PORTEE DU MODELE
#
# Un message dont l'expediteur ou l'objet correspond ici est enregistre, mais
# son corps n'est JAMAIS transmis a une API, jamais resume, et aucun brouillon
# n'est redige. Banque, administration, sante restent entre la boite et moi.
# Les motifs d'expediteur acceptent le joker « * ».
# ---------------------------------------------------------------------------
SENSITIVE_SENDERS=*@*banque*,*@*credit*,*@ameli.fr,*@impots.gouv.fr,*@*assurance*,*@*mutuelle*,*@*notaire*
SENSITIVE_SUBJECTS=releve de compte,virement,rib,code secret,resultat d analyse,arret de travail,bulletin de paie

# ---------------------------------------------------------------------------
# MISE A JOUR DEPUIS GITHUB
#
# L'application ne met jamais a jour son propre code : elle depose une demande
# dans son dossier de donnees, et un executeur lance par systemd — EN DEHORS du
# conteneur, en root — telecharge, reconstruit, redemarre, et revient en arriere
# si la nouvelle version ne se declare pas en bonne sante.
#
# Le conteneur ne voit JAMAIS le socket Docker : le socket Docker, c'est root
# sur l'hote.
#
# Les branches declarees ici servent a l'AFFICHAGE et a la verification de
# version. La correspondance canal -> branche qui fait foi est celle du service
# root (deploy/inbox-agent-update.service) : l'application ne peut donc pas
# diriger l'executeur vers une reference de son choix.
# ---------------------------------------------------------------------------
UPDATE_ENABLED=false
UPDATE_REPO=Lokyron/mail-automate
UPDATE_BRANCH=main
# Vide = ne proposer que le canal stable.
UPDATE_BETA_BRANCH=beta
UPDATE_CHECK_HOURS=24

# --- Docker -----------------------------------------------------------------
# Dossier de donnees sur l'HOTE (base SQLite + echanges avec l'executeur).
# Sur un serveur : /var/lib/inbox-agent. Il doit appartenir a l'uid 1000.
DATA_DIR=./data
# Port d'ecoute sur l'HOTE (publie sur 127.0.0.1 uniquement).
PORT_HOTE=8090
# Port HTTPS du profil « tls » (docker compose --profile tls up -d).
PORT_HTTPS=8443
# Adresse par laquelle tu joins l'interface : une IP (10.1.20.124) ou un nom
# (inbox.exemple.fr). OBLIGATOIRE avec le profil « tls » : le certificat
# auto-signe ne peut etre delivre que pour une adresse declaree. Sans elle, le
# navigateur annonce « site inaccessible » sans autre explication.
CADDY_SITE=
# Requis par le profil « tls » : sans cela l'application ne voit pas que la
# requete est arrivee en HTTPS et n'appose pas le drapeau Secure sur le cookie.
# install.sh le renseigne pour toi si tu choisis ce profil.
# TRUSTED_PROXIES=172.16.0.0/12

# ---------------------------------------------------------------------------
# REGLAGES AVANCES
# Tous ont un defaut raisonnable. A ne toucher qu'avec une raison precise :
# epingler une version d'API, deplacer la base, allonger un delai.
# ---------------------------------------------------------------------------
# DB_PATH=./data/inbox-agent.db
# LLM_TIMEOUT_MS=60000
# DRAFTS_TIMEOUT_MS=120000
# IMAP_MAX_BODY_BYTES=524288       # par PARTIE de texte ; les pieces jointes ne sont jamais telechargees
# CLAUDE_API_BASE=https://api.anthropic.com
# CLAUDE_API_VERSION=2023-06-01
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# TELEGRAM_API_BASE=https://api.telegram.org
